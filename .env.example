# Contact form delivery.
#
# Leave VITE_CONTACT_ENDPOINT empty and the form keeps its original behaviour:
# it opens the visitor's email client with the message pre-filled. Set an
# endpoint and submissions are POSTed directly, so you receive them in your
# inbox without any mail client involved.
#
# Vite inlines VITE_* variables at build time. On GitHub Pages they must be
# provided by the build workflow (repository secrets exposed to the job), not
# committed here.

# Any endpoint accepting a JSON POST. Examples:
#   Formspree   https://formspree.io/f/xxxxxxxx
#   Web3Forms   https://api.web3forms.com/submit
#   Getform     https://getform.io/f/xxxxxxxx
#   Basin       https://usebasin.com/f/xxxxxxxx
VITE_CONTACT_ENDPOINT=

# Only needed by services that authenticate with a key in the body (Web3Forms).
VITE_CONTACT_ACCESS_KEY=